# --- Django Core Settings ------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*,localhost,127.0.0.1,.onrender.com,.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://your-frontend.onrender.com,http://localhost:5173

# --- Runtime & Server (Render dynamic defaults) --------------------------
# PYTHON_VERSION=3.12.10
# PORT=10000
# WEB_CONCURRENCY=1
# WEB_THREADS=4

# --- Database (pick ONE) --------------------------------------------------
# Option A (Recommended for production): PostgreSQL. Permanent and persistent.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Option B: SQLite (default fallback).
# On Render free tier, SQLite data is reset on each redeploy/restart.
# If you attach a Persistent Disk at /var/data on Render, uncomment:
# DATA_DIR=/var/data

# --- Cloud Storage for Media/Images (Optional) ----------------------------
# Without Cloudinary, uploaded media is stored locally in /media/
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
