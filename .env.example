# --- required -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# --- database: pick ONE ---------------------------------------------------
# Option A (recommended): a real PostgreSQL. Data is permanent and shared.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Option B: SQLite. Fine on Render because it is a single long-running
# process, but the filesystem is wiped on every redeploy unless DATA_DIR
# points at a Persistent Disk.
# DATABASE_URL=
# DATA_DIR=/var/data

# --- optional: durable product images ------------------------------------
# Without these, uploads go to local disk (lost on redeploy).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
